# Normalize line endings on commit; check out LF everywhere.
# Shell hooks MUST be LF — a CRLF shebang makes the kernel fail to find the
# interpreter, and the resulting error names the interpreter rather than the
# line ending, which makes it slow to diagnose.
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
.githooks/*  text eol=lf

# Binary/asset types git should not try to normalize.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.woff  binary
*.woff2 binary
